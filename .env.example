# MineBBS / game server
MINEBBS_CLIENT_ID=
MINEBBS_CLIENT_SECRET=
MINEBBS_REDIRECT_URI=https://runningsteve.minebbs.com/auth/callback
PUBLIC_ORIGIN=https://runningsteve.minebbs.com
SESSION_SECRET=change-me-long-random

# Production MySQL (server-provided)
MYSQL_URL=mysql://user:pass@127.0.0.1:3306/runningsteve
# DB_DRIVER=mysql is implied when MYSQL_URL is set
# Local offline dev can use DB_DRIVER=memory
